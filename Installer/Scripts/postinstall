#!/bin/bash
set -euo pipefail

# A non-startup volume has no matching GUI session. Do not modify the running
# system's input sources when installing to another volume.
if [[ "${3:-/}" != "/" ]]; then
    echo "KeyKey: add the input source after starting from the target volume."
    exit 0
fi

if ! console_uid=$(/usr/bin/stat -f %u /dev/console); then
    echo "KeyKey: console user is unavailable; add the input source in Keyboard settings after login."
    exit 0
fi
if [[ ! "$console_uid" =~ ^[0-9]+$ ]] || (( console_uid < 500 )); then
    echo "KeyKey: no logged-in console user; add the input source in Keyboard settings after login."
    exit 0
fi

helper="/Library/Input Methods/chichi77 KeyKey.app/Contents/MacOS/KeyKeyInputSourceTool"
# Keep only replacement safety. macOS rebuilds the input-method session after
# the required logout/login; do not register, enable or restore TIS state here.
if ! /bin/launchctl asuser "$console_uid" /usr/bin/sudo -H -u "#$console_uid" -- /usr/bin/env -u __CF_USER_TEXT_ENCODING \
    "$helper" --finish-upgrade; then
    echo "KeyKey: files were installed; retiring an old process was unconfirmed. Save work, log out of macOS and log back in before using KeyKey." >&2
fi
echo "KeyKey: installation complete. Save work, log out of macOS and log back in. Keep the existing KeyKey entry when upgrading."
exit 0
