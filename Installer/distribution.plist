<?xml version="1.0" encoding="utf-8" standalone="no"?>
<installer-gui-script minSpecVersion="1">
    <title>chichi77 KeyKey</title>
    <organization>io.github.polobread</organization>
    <domains enable_localSystem="true"/>
    <!-- These are Installer evaluation architectures, not payload architectures.
         arm64 avoids an unnecessary Rosetta dependency; x86_64 lets Intel users
         reach the localized hardware rejection below. -->
    <options customize="never" rootVolumeOnly="true" hostArchitectures="arm64,x86_64" />
    <!-- Use a scripted check so Intel users see the specific hardware requirement. -->
    <installation-check script="checkHostArchitecture()" />
    <script><![CDATA[
        function checkHostArchitecture() {
            try {
                if (system.sysctl('hw.optional.arm64') == 1) return true;
            } catch (error) {
                // A missing capability is unsupported, never permission to run arm64 code.
            }
            my.result.type = 'Fatal';
            my.result.title = system.localizedString('AppleSiliconRequiredTitle');
            my.result.message = system.localizedString('AppleSiliconRequiredMessage');
            return false;
        }
    ]]></script>
    <volume-check>
        <allowed-os-versions>
            <os-version min="15.0"/>
        </allowed-os-versions>
    </volume-check>
    <!-- Define documents displayed at various steps -->
    <license    file="License.rtf"       mime-type="application/rtf" />
    <conclusion file="Conclusion.html" mime-type="text/html" />
    <!-- List all component packages -->
    <pkg-ref id="io.github.polobread.chichi77.installerpackage"
             version="0"
             auth="root">chichi77KeyKeyApp.pkg</pkg-ref>
    <!-- List them again here. They can now be organized
         as a hierarchy if you want. -->
    <choices-outline>
        <line choice="io.github.polobread.chichi77.installerpackage"/>
    </choices-outline>
    <!-- Define each choice above -->
    <choice
        id="io.github.polobread.chichi77.installerpackage"
        visible="false"
        title="chichi77 KeyKey"
        description="chichi77 KeyKey"
        start_selected="true">
      <pkg-ref id="io.github.polobread.chichi77.installerpackage" onConclusion="RequireLogout"/>
    </choice>
</installer-gui-script>
