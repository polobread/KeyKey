{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Ninja + MSVC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/x64-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64 (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "ARM64",
      "binaryDir": "${sourceDir}/out/build/arm64"
    },
    {
      "name": "windows-x64-vs2026",
      "displayName": "Windows x64 (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/x64-vs2026"
    },
    {
      "name": "windows-x64-vs2022",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/x64-vs2022"
    },
    {
      "name": "windows-x86-vs2022",
      "displayName": "Windows x86 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/out/build/x86-vs2022"
    },
    {
      "name": "windows-x86",
      "displayName": "Windows x86 (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/out/build/x86"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64"
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "windows-arm64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-vs2026-release",
      "configurePreset": "windows-x64-vs2026",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-vs2022-release",
      "configurePreset": "windows-x64-vs2022",
      "configuration": "Release"
    },
    {
      "name": "windows-x86-vs2022-release",
      "configurePreset": "windows-x86-vs2022",
      "configuration": "Release"
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86",
      "configuration": "Release"
    }
  ]
}
