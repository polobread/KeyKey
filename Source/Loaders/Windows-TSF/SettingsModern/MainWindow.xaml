<Window x:Class="KeyKeySettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="琦琦輸入法設定" Width="900" Height="720" MinWidth="680" MinHeight="550"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft JhengHei UI"
        ThemeMode="System">
  <Window.Resources>
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,0,18" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinWidth" Value="190" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,6,0,10" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="24,18,24,18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="琦琦輸入法" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="設定" FontSize="14" Opacity="0.7" />
    </StackPanel>
    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="版本 1.3.2" VerticalAlignment="Center" Opacity="0.65" />
      <TextBlock x:Name="Status" Grid.Column="1" Margin="20,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="ApplyButton" Content="套用" Click="Apply_Click" IsDefault="True" />
        <Button Content="關閉" Click="Close_Click" IsCancel="True" />
      </StackPanel>
    </Grid>
    <TabControl>
      <TabItem Header="一般">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,20,8">
          <GroupBox Header="鍵盤與輸入法">
            <StackPanel>
              <TextBlock Text="實體鍵盤配置" FontWeight="SemiBold" />
              <TextBlock Text="美式鍵盤（固定）" Margin="0,6,0,8" />
              <TextBlock Text="啟動時預設輸入模式" FontWeight="SemiBold" Margin="0,10,0,8" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="DefaultChineseMode" Content="中文" GroupName="DefaultInputMode" Margin="0,0,22,0" />
                <RadioButton x:Name="DefaultEnglishMode" Content="英文" GroupName="DefaultInputMode" />
              </StackPanel>
              <TextBlock Text="下次啟用琦琦輸入法時生效；中文沿用目前選擇的好打注音、傳統注音、倉頡或簡易。仍可按 Shift 切換中英文。" TextWrapping="Wrap" Opacity="0.7" />
              <TextBlock Text="在工作列輸入法選單顯示" FontWeight="SemiBold" Margin="0,10,0,8" />
              <CheckBox x:Name="ShowSmartMandarin" Content="好打注音" Margin="0,0,0,8" />
              <CheckBox x:Name="ShowTraditionalMandarin" Content="傳統注音" Margin="0,0,0,8" />
              <CheckBox x:Name="ShowCangjie" Content="倉頡" Margin="0,0,0,8" />
              <CheckBox x:Name="ShowSimplex" Content="簡易" Margin="0,0,0,8" />
              <TextBlock Text="至少保留一種輸入法；工作列選單可直接切換。" Opacity="0.7" />
            </StackPanel>
          </GroupBox>
          <GroupBox Header="選字窗">
            <StackPanel>
              <TextBlock Text="顯示方向" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                <RadioButton x:Name="VerticalCandidate" Content="垂直" GroupName="CandidateDirection" Margin="0,0,22,0" />
                <RadioButton x:Name="HorizontalCandidate" Content="水平" GroupName="CandidateDirection" />
              </StackPanel>
              <TextBlock Text="大小" FontWeight="SemiBold" />
              <ComboBox x:Name="CandidateScale" />
              <TextBlock Text="也套用到符號表與 Emoji；跟隨 Windows 時，使用目前顯示器的縮放比例。" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12" />
              <TextBlock Text="反白顏色" FontWeight="SemiBold" />
              <ComboBox x:Name="HighlightColor" />
            </StackPanel>
          </GroupBox>
          <GroupBox Header="快捷鍵與提示聲">
            <StackPanel>
              <CheckBox x:Name="ControlBackslash" Content="使用 Ctrl + \ 切換中英文模式" Margin="0,0,0,12" />
              <CheckBox x:Name="TypingBeep" Content="輸入錯誤時發出提示聲" Margin="0,0,0,12" />
              <CheckBox x:Name="SimplifiedChineseOutput" Content="簡體中文輸出（四種輸入法）" Margin="0,0,0,12" />
              <TextBlock Text="切換時先以原設定送出目前組字，後續輸入使用新設定。" Opacity="0.7" Margin="0,0,0,12" />
              <TextBlock Text="單按 Shift 或 Ctrl+Space 切換中英文；Shift+Space 切換全半形。" Opacity="0.7" />
            </StackPanel>
          </GroupBox>
          <GroupBox Header="問題診斷">
            <StackPanel>
              <CheckBox x:Name="DiagnosticLogging" Content="啟用診斷記錄" Margin="0,0,0,10"
                        Checked="DiagnosticLogging_Changed" Unchecked="DiagnosticLogging_Changed" />
              <TextBlock Text="預設關閉。開啟並套用後記錄 3 天，到期自動停止；輸入記錄最多保留 20 MB。記錄包含按鍵代碼與視窗狀態，供追查輸入問題。" Opacity="0.7" />
              <TextBlock x:Name="DiagnosticStatus" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </GroupBox>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="注音">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,20,8">
          <GroupBox Header="注音輸入法">
            <StackPanel>
              <TextBlock Text="鍵盤配置" FontWeight="SemiBold" />
              <ComboBox x:Name="PhoneticLayout" />
              <CheckBox x:Name="RareCharacters" Content="使用全字庫罕用字（CNS11643）" Margin="0,10,0,10" />
              <TextBlock Text="關閉時僅顯示 Big-5 可表示的候選字。設定會在下一次按鍵時生效。" Opacity="0.7" />
            </StackPanel>
          </GroupBox>
          <GroupBox Header="好打注音進階設定"><StackPanel>
            <CheckBox x:Name="ShowCandidateListWithSpace" Content="空白鍵開啟候選" Margin="0,0,0,12" />
            <CheckBox x:Name="CandidateCursorAtEndOfTargetBlock" Content="選字目標在游標前方" Margin="0,0,0,8" />
            <TextBlock Text="例如「今天｜天氣」：勾選時選前方的「今天」，取消時選後方的「天氣」。這是候選目標，不是選字後游標位置。" Opacity="0.7" Margin="0,0,0,12" />
            <TextBlock Text="選字按鍵（留空依鍵盤配置自動；或 8 個不重複 ASCII 按鍵）" />
            <TextBox x:Name="CandidateSelectionKeys" MaxLength="8" Margin="0,5,0,12" />
            <Button Content="使用數字 12345678" Click="UseNumericSelectionKeys_Click" HorizontalAlignment="Left" Margin="0,0,0,12" />
            <TextBlock Text="組字區長度（10–20 音節）" />
            <TextBox x:Name="ComposingTextBufferSize" MaxLength="3" Margin="0,5,0,8" />
            <CheckBox x:Name="ClearSmartCompositionWithEsc" Content="按 Esc 清除好打注音已完成的整句" Margin="0,18,0,8" />
            <TextBlock Text="預設保留整句；候選窗開啟時 Esc 只關閉候選，未完成讀音則只清除讀音。" Opacity="0.7" />
            <TextBlock Text="套用後，下一次輸入先送出原組字，再啟用新設定。" Opacity="0.7" Margin="0,12,0,0" />
          </StackPanel></GroupBox>
          <GroupBox Header="好打注音學習紀錄"><StackPanel>
            <TextBlock Text="重設會清除好打注音的選字與前後文學習紀錄；自訂詞與倉頡／簡易排序紀錄會保留。" Opacity="0.7" Margin="0,0,0,12" />
            <Button Content="重設好打注音學習紀錄…" Click="ResetLearning_Click" HorizontalAlignment="Left" />
          </StackPanel></GroupBox>
          <TextBlock Text="好打注音會整句組字並學習選字；輸入法可從工作列直接切換。" Opacity="0.7" />
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="倉頡／簡易">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,20,8">
          <GroupBox Header="倉頡">
            <StackPanel>
              <TextBlock Text="最多五碼；空白或 Enter 查詢候選，數字選字。? 代表一個字根，* 代表任意長度字根。" Opacity="0.7" Margin="0,0,0,12" />
              <CheckBox x:Name="CangjieCommitAtMaximum" Content="輸入滿五碼時自動查詢或送出單一候選" Margin="0,0,0,12" />
              <CheckBox x:Name="CangjieDynamicFrequency" Content="依選字紀錄調整候選順序" Margin="0,0,0,12" />
              <CheckBox x:Name="CangjieComposeWhileTyping" Content="邊打邊顯示候選" Checked="TableCompose_Checked" Margin="0,0,0,12" />
              <CheckBox x:Name="CangjieClearOnError" Content="找不到候選時清除字根" Checked="TableClear_Checked" Margin="0,0,0,12" />
              <CheckBox x:Name="CangjieRareCharacters" Content="使用全字庫罕用字（CNS11643）" Margin="0,0,0,12" />
              <TextBlock Text="標點配置" FontWeight="SemiBold" />
              <ComboBox x:Name="CangjiePunctuation" AutomationProperties.Name="倉頡標點配置" />
            </StackPanel>
          </GroupBox>
          <GroupBox Header="簡易">
            <StackPanel>
              <TextBlock Text="最多兩碼；滿兩碼自動查詢或送出單一候選，數字選字、空白翻頁。" Opacity="0.7" Margin="0,0,0,12" />
              <CheckBox x:Name="SimplexComposeWhileTyping" Content="邊打邊顯示候選" Checked="TableCompose_Checked" Margin="0,0,0,12" />
              <CheckBox x:Name="SimplexClearOnError" Content="找不到候選時清除字根" Checked="TableClear_Checked" Margin="0,0,0,12" />
              <CheckBox x:Name="SimplexRareCharacters" Content="使用全字庫罕用字（CNS11643）" />
            </StackPanel>
          </GroupBox>
          <TextBlock Text="邊打邊顯示候選與錯碼清除擇一使用。關閉全字庫時僅顯示 Big-5 可表示的候選字。" Opacity="0.7" />
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="關聯詞庫">
        <Grid Margin="16,20,20,8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="選擇要啟用的關聯詞詞庫。變更會在下一次輸入時生效。" Margin="0,0,0,12" />
          <DataGrid x:Name="Collections" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                    HeadersVisibility="Column" IsReadOnly="False" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="啟用" Width="70">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="詞庫" Binding="{Binding Display}" IsReadOnly="True" Width="*" />
              <DataGridTextColumn Header="識別碼" Binding="{Binding Source}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="全部啟用" Click="EnableAll_Click" />
            <Button Content="僅基本詞庫" Click="BaseOnly_Click" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="自訂詞">
        <Grid Margin="16,20,20,8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="自訂詞用於好打注音；每個字的讀音以半形逗號分隔。" Margin="0,0,0,12" />
          <DataGrid x:Name="UserPhrases" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" SelectionMode="Single" SelectionChanged="UserPhrases_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="詞語" Binding="{Binding Text}" Width="*" />
              <DataGridTextColumn Header="注音讀音" Binding="{Binding Reading}" Width="2*" />
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="2" Margin="0,12,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="詞語"/><TextBox x:Name="PhraseText" Margin="0,5,0,0" TextChanged="PhraseText_Changed"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="注音讀音"/><TextBox x:Name="PhraseReading" Margin="0,5,0,0"/></StackPanel>
          </Grid>
          <WrapPanel Grid.Row="3" Margin="0,0,0,10">
            <Button x:Name="LookupReadingsButton" Content="取得讀音" Click="LookupReadings_Click" />
            <Button x:Name="AddPhraseButton" Content="新增" Click="AddPhrase_Click" />
            <Button x:Name="UpdatePhraseButton" Content="修改選取詞" Click="UpdatePhrase_Click" />
            <Button Content="刪除選取詞" Click="DeletePhrase_Click" />
          </WrapPanel>
          <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <ComboBox x:Name="WholePhraseReadings" Visibility="Collapsed" SelectionChanged="WholePhraseReadings_Changed" AutomationProperties.Name="詞庫完整詞讀音" />
            <ScrollViewer MaxHeight="125" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="CharacterReadingPanel" /></ScrollViewer>
            <TextBlock x:Name="ReadingStatus" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <WrapPanel Grid.Row="5">
            <Button Content="匯入使用者資料庫…" Click="Import_Click" />
            <Button Content="匯出使用者資料庫…" Click="Export_Click" />
            <TextBlock Text="匯入會合併自訂詞並載入好打注音學習紀錄。" VerticalAlignment="Center" Opacity="0.7" />
          </WrapPanel>
        </Grid>
      </TabItem>
      <TabItem Header="更新">
        <StackPanel Margin="24">
          <TextBlock Text="琦琦輸入法更新" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
          <TextBlock x:Name="UpdateStatus" Margin="0,0,0,20" />
          <CheckBox x:Name="AutomaticUpdates" Content="設定視窗開啟時自動檢查更新（每天一次）"
                    IsEnabled="False" Checked="AutomaticUpdates_Changed" Unchecked="AutomaticUpdates_Changed" Margin="0,0,0,20" />
          <Button x:Name="CheckUpdate" Content="立即檢查更新" Click="CheckUpdate_Click" IsEnabled="False" HorizontalAlignment="Left" />
          <TextBlock Text="下載與安裝仍需確認。請先套用設定；若有未儲存的編輯，更新程式不會關閉此視窗啟動安裝。更新會保留個人設定、自訂詞與學習紀錄。安裝後請登出再登入。"
                     Margin="0,20,0,0" Opacity="0.7" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
