<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>../SettingsModern/app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SettingsModern/KeyKeySettings.csproj" />
  </ItemGroup>
  <Target Name="CopyTestRuntime" AfterTargets="Build" Condition="'$(KeyKeyRuntimeDirectory)' != ''">
    <Copy SourceFiles="$(KeyKeyRuntimeDirectory)/KeyKeySettingsBackend.dll" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="$(KeyKeyRuntimeDirectory)/Databases/KeyKey.db" DestinationFolder="$(TargetDir)/Databases" />
  </Target>
</Project>
