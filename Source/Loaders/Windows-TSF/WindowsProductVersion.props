<Project>
  <PropertyGroup>
    <KeyKeyProductVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)CMakeLists.txt')), 'project\(KeyKeyWindowsTsf VERSION ([0-9]+(?:\.[0-9]+){2,3}) LANGUAGES C CXX\)').Groups[1].Value)</KeyKeyProductVersion>
    <Version Condition="'$(Version)' == ''">$(KeyKeyProductVersion)</Version>
  </PropertyGroup>
  <Target Name="ValidateKeyKeyProductVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(KeyKeyProductVersion)' == ''" Text="Could not read the Windows product version from CMakeLists.txt." />
  </Target>
</Project>
