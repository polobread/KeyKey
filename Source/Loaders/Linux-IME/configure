#!/bin/sh

set -eu

program_name=${0##*/}

usage() {
    cat <<'EOF'
Usage: configure [OPTION]...

Configure chichi77 KeyKey for a traditional GNU Make build. This is a thin
frontend for CMake's Unix Makefiles generator; Autoconf and Ninja are not
required.

Installation directories:
  --prefix=PATH              install architecture-independent files in PATH
                             [/usr/local]
  --libdir=PATH              install libraries in PATH [platform default]
  --datadir=PATH             install read-only data in PATH [share]

Build options:
  --enable-fcitx5            build the Fcitx 5 addon [default]
  --disable-fcitx5           build the engine without the Fcitx 5 addon
  --enable-tests             build tests and provide make check [default]
  --disable-tests            do not build the test suite
  --enable-x11-e2e-host      build the GTK 3 X11 test host [disabled]
  --disable-x11-e2e-host     do not build the GTK 3 X11 test host [default]
  --enable-sanitizers        enable AddressSanitizer and UBSan [disabled]
  --disable-sanitizers       disable AddressSanitizer and UBSan [default]
  -h, --help                 display this help and exit

Environment variables:
  CXX                        C++ compiler
  CPPFLAGS                   C/C++ preprocessor flags
  CXXFLAGS                   C++ compiler flags
  LDFLAGS                    executable, shared, and module linker flags

After configuration, run:
  make -j2
  make check
  make DESTDIR="$PWD/out/source-stage" install
  make DESTDIR="$PWD/out/source-stage" uninstall
  make clean
  make distclean

DESTDIR is a staging root and is intentionally not embedded in installed
metadata or in the addon's runtime data path.
EOF
}

fail() {
    printf '%s: error: %s\n' "$program_name" "$*" >&2
    exit 2
}

require_value() {
    option_name=$1
    option_value=$2
    if [ -z "$option_value" ]; then
        fail "$option_name requires a non-empty path"
    fi
}

prefix=/usr/local
libdir=
datadir=
build_fcitx5=ON
build_testing=ON
build_x11_e2e_host=OFF
enable_sanitizers=OFF

while [ "$#" -gt 0 ]; do
    case "$1" in
        --prefix=*)
            prefix=${1#*=}
            require_value --prefix "$prefix"
            ;;
        --prefix)
            shift
            [ "$#" -gt 0 ] || fail "--prefix requires a path"
            prefix=$1
            require_value --prefix "$prefix"
            ;;
        --libdir=*)
            libdir=${1#*=}
            require_value --libdir "$libdir"
            ;;
        --libdir)
            shift
            [ "$#" -gt 0 ] || fail "--libdir requires a path"
            libdir=$1
            require_value --libdir "$libdir"
            ;;
        --datadir=*)
            datadir=${1#*=}
            require_value --datadir "$datadir"
            ;;
        --datadir)
            shift
            [ "$#" -gt 0 ] || fail "--datadir requires a path"
            datadir=$1
            require_value --datadir "$datadir"
            ;;
        --enable-fcitx5) build_fcitx5=ON ;;
        --disable-fcitx5) build_fcitx5=OFF ;;
        --enable-tests) build_testing=ON ;;
        --disable-tests) build_testing=OFF ;;
        --enable-x11-e2e-host) build_x11_e2e_host=ON ;;
        --disable-x11-e2e-host) build_x11_e2e_host=OFF ;;
        --enable-sanitizers) enable_sanitizers=ON ;;
        --disable-sanitizers) enable_sanitizers=OFF ;;
        -h|--help)
            usage
            exit 0
            ;;
        *) fail "unknown option: $1 (run ./$program_name --help)" ;;
    esac
    shift
done

case "$prefix" in
    /*) ;;
    *) fail "--prefix must be an absolute path: $prefix" ;;
esac
if [ "$build_x11_e2e_host" = ON ] && [ "$build_testing" = OFF ]; then
    fail "--enable-x11-e2e-host requires --enable-tests"
fi

for required_command in cmake make; do
    command -v "$required_command" >/dev/null 2>&1 ||
        fail "required command not found: $required_command"
done

make_version=$(make --version 2>/dev/null || true)
case "$make_version" in
    "GNU Make "*) ;;
    *) fail "GNU Make is required" ;;
esac

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
invocation_dir=$(pwd -P)

if [ "$invocation_dir" = "$script_dir" ]; then
    build_dir_relative=out/build/configure-make
else
    build_dir_relative=.keykey-configure-build
fi
build_dir=$invocation_dir/$build_dir_relative
wrapper_makefile=$invocation_dir/Makefile
makefile_marker='# Generated by chichi77 KeyKey configure. Run make distclean to remove.'

if [ -e "$wrapper_makefile" ] &&
        ! grep -Fqx "$makefile_marker" "$wrapper_makefile"; then
    fail "refusing to overwrite an existing Makefile in $invocation_dir"
fi

combined_cxxflags=${CPPFLAGS-}
if [ -n "${CXXFLAGS-}" ]; then
    if [ -n "$combined_cxxflags" ]; then
        combined_cxxflags="$combined_cxxflags $CXXFLAGS"
    else
        combined_cxxflags=$CXXFLAGS
    fi
fi

set -- cmake -S "$script_dir" -B "$build_dir" -G 'Unix Makefiles' \
    "-DCMAKE_BUILD_TYPE=Release" \
    "-DCMAKE_INSTALL_PREFIX=$prefix" \
    "-DCMAKE_CXX_FLAGS=$combined_cxxflags" \
    "-DCMAKE_EXE_LINKER_FLAGS=${LDFLAGS-}" \
    "-DCMAKE_SHARED_LINKER_FLAGS=${LDFLAGS-}" \
    "-DCMAKE_MODULE_LINKER_FLAGS=${LDFLAGS-}" \
    "-DBUILD_TESTING=$build_testing" \
    "-DKEYKEY_BUILD_FCITX5=$build_fcitx5" \
    "-DKEYKEY_BUILD_X11_E2E_HOST=$build_x11_e2e_host" \
    "-DKEYKEY_ENABLE_SANITIZERS=$enable_sanitizers"

if [ -n "$libdir" ]; then
    set -- "$@" "-DCMAKE_INSTALL_LIBDIR=$libdir"
fi
if [ -n "$datadir" ]; then
    set -- "$@" "-DCMAKE_INSTALL_DATADIR=$datadir"
fi
if [ -n "${CXX-}" ]; then
    set -- "$@" "-DCMAKE_CXX_COMPILER=$CXX"
fi

build_dir_preexisting=false
if [ -e "$build_dir" ]; then
    build_dir_preexisting=true
fi
if "$@"; then
    :
else
    configure_status=$?
    if [ "$build_dir_preexisting" = false ]; then
        cmake -E remove_directory "$build_dir"
    fi
    exit "$configure_status"
fi

makefile_tmp=$invocation_dir/.keykey-configure-makefile.tmp.$$
trap 'rm -f "$makefile_tmp"' EXIT HUP INT TERM
cat >"$makefile_tmp" <<EOF
$makefile_marker
KEYKEY_CONFIGURE_BUILD_DIR := $build_dir_relative

.PHONY: all check install uninstall clean distclean

all:
	+\$(MAKE) -C "\$(KEYKEY_CONFIGURE_BUILD_DIR)" all
EOF

if [ "$build_testing" = ON ]; then
cat >>"$makefile_tmp" <<'EOF'
check:
	+$(MAKE) -C "$(KEYKEY_CONFIGURE_BUILD_DIR)" check
EOF
else
cat >>"$makefile_tmp" <<'EOF'
check:
	@echo "Tests were disabled at configure time; rerun configure with --enable-tests." >&2
	@false
EOF
fi

cat >>"$makefile_tmp" <<'EOF'
install:
	+$(MAKE) -C "$(KEYKEY_CONFIGURE_BUILD_DIR)" install

uninstall:
	+$(MAKE) -C "$(KEYKEY_CONFIGURE_BUILD_DIR)" uninstall

clean:
	+$(MAKE) -C "$(KEYKEY_CONFIGURE_BUILD_DIR)" clean

distclean:
	@cmake -E remove_directory "$(KEYKEY_CONFIGURE_BUILD_DIR)"
	@cmake -E rm -f "$(firstword $(MAKEFILE_LIST))"
EOF
mv -f "$makefile_tmp" "$wrapper_makefile"
trap - EXIT HUP INT TERM

install_layout=$build_dir/keykey-install-layout.txt
full_libdir=$(sed -n 's/^full_libdir=//p' "$install_layout")
full_datadir=$(sed -n 's/^full_datadir=//p' "$install_layout")

if [ "$build_testing" = ON ]; then
    next_steps="Run 'make -j2' and 'make check'."
else
    next_steps="Run 'make -j2'. Tests and 'make check' are disabled."
fi

cat <<EOF

Configuration complete:
  source directory:     $script_dir
  build directory:      $build_dir
  installation prefix: $prefix
  library directory:   $full_libdir
  data directory:      $full_datadir
  Fcitx 5 addon:        $build_fcitx5
  tests:                $build_testing
  GTK 3 X11 test host: $build_x11_e2e_host

$next_steps Use 'make distclean' to remove only the Makefile and build
directory generated by this configure invocation.
EOF
