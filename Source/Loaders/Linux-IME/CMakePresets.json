{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-release",
      "displayName": "Linux Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "KEYKEY_BUILD_FCITX5": "ON",
        "KEYKEY_ENABLE_GUANYINMA": "OFF"
      }
    },
    {
      "name": "engine-only",
      "displayName": "Portable engine tests (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/engine-only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KEYKEY_BUILD_FCITX5": "OFF",
        "KEYKEY_ENABLE_GUANYINMA": "OFF"
      }
    },
    {
      "name": "engine-sanitized",
      "displayName": "Engine tests with ASan and UBSan (Ninja)",
      "inherits": "engine-only",
      "binaryDir": "${sourceDir}/out/build/engine-sanitized",
      "cacheVariables": {
        "KEYKEY_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "linux-guanyinma",
      "displayName": "Linux dual core (Guanyinma default)",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/out/build/guanyinma",
      "cacheVariables": {
        "KEYKEY_ENABLE_GUANYINMA": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "engine-only",
      "configurePreset": "engine-only"
    },
    {
      "name": "engine-sanitized",
      "configurePreset": "engine-sanitized"
    },
    {
      "name": "linux-guanyinma",
      "configurePreset": "linux-guanyinma"
    }
  ],
  "testPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "engine-only",
      "configurePreset": "engine-only",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "engine-sanitized",
      "configurePreset": "engine-sanitized",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-guanyinma",
      "configurePreset": "linux-guanyinma",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
