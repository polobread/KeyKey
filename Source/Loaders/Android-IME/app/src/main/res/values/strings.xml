<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">琦琦注音</string>
    <string name="ime_name">琦琦注音輸入法</string>
    <string name="ime_subtype_name">繁體中文（標準注音）</string>
    <string name="setup_title">琦琦注音輸入法</string>
    <string name="version_info">版本 %1$s</string>
    <string name="setup_description">使用與電腦相同的標準注音鍵位，支援可選關聯詞詞庫、直式、橫式以及 USB／藍牙實體鍵盤。</string>
    <string name="enable_ime">1. 啟用輸入法</string>
    <string name="choose_ime">2. 選擇琦琦注音</string>
    <string name="open_settings">3. 調整設定</string>
    <string name="settings_title">琦琦注音設定</string>
    <string name="composition_mode_title">注音模式</string>
    <string-array name="composition_modes">
        <item>好打注音</item>
        <item>傳統注音</item>
    </string-array>
    <string name="composition_mode_description">好打注音會連續組句，不必逐字選字；按 Enter 送出整句。使用實體鍵盤時，按 ←／→ 移動組字游標，Space／↓ 開啟游標處的字詞候選，↑／↓ 或 1–9 選字詞。傳統注音維持逐字選字的操作方式。</string>
    <string name="haptic_feedback_title">按鍵震動回饋</string>
    <string name="haptic_feedback_description">可選 0、1、2、3、5、10、20、30、50、100 毫秒。放開滑桿後會以所選時間試震一次；設定為 0 時關閉震動。</string>
    <string name="haptic_off">0 秒（關閉）</string>
    <string name="haptic_maximum">0.1 秒</string>
    <string name="haptic_value_off">震動時間：關閉</string>
    <string name="haptic_value_seconds">震動時間：%1$s 秒（%2$d ms）</string>
    <string name="keyboard_size_title">虛擬鍵盤高度</string>
    <string name="keyboard_size_description" formatted="false">直式與橫式可分別選擇 50%、75%、90%、100%、110%、125%、150%、175%、200%；只影響螢幕虛擬鍵盤，實體鍵盤候選字窗維持原尺寸。</string>
    <string name="keyboard_size_portrait">直式虛擬鍵盤</string>
    <string name="keyboard_size_landscape">橫式虛擬鍵盤</string>
    <string name="keyboard_size_value">目前高度：%1$d%%</string>
    <string name="keyboard_size_minimum">50%</string>
    <string name="keyboard_size_maximum">200%</string>
    <string name="key_preview_enabled">顯示觸控按鍵預覽</string>
    <string name="key_preview_description">按住文字、注音或符號鍵時，在按鍵上方或附近顯示放大的按鍵圖，方便確認是否按對。</string>
    <string name="candidate_color_title">候選字底色</string>
    <string-array name="candidate_highlight_colors">
        <item>紫色（預設）</item>
        <item>綠色</item>
        <item>黃色</item>
        <item>紅色</item>
    </string-array>
    <string name="floating_candidates_enabled">實體鍵盤使用浮動候選字窗</string>
    <string name="floating_candidates_failure_token">已改用一般候選列：系統或目標 App 未提供可用的輸入法視窗 token。重新勾選可再試一次。</string>
    <string name="floating_candidates_failure_attach">已改用一般候選列：系統拒絕附掛浮動候選字窗。重新勾選可再試一次。</string>
    <string name="floating_candidates_layout">浮動候選字窗排列</string>
    <string-array name="floating_candidate_layouts">
        <item>垂直選字窗</item>
        <item>水平選字窗</item>
    </string-array>
    <string name="floating_candidate_item_vertical">%1$d&#x2009;%2$s</string>
    <string name="floating_candidate_item_horizontal">%1$d %2$s</string>
    <string name="floating_candidate_description">第 %1$d 個候選，%2$s</string>
    <string name="supporter_section_title">支持開發</string>
    <string name="supporter_description">琦琦輸入法即使未付費也可以繼續完整使用。如果覺得好用，歡迎一次付費支持後續維護與開發。</string>
    <string name="supporter_button">付費支持</string>
    <string name="supporter_thank_you">謝謝支持</string>
    <string name="supporter_checking">正在確認…</string>
    <string name="supporter_price">一次付費支持：%1$s</string>
    <string name="supporter_prompt">歡迎付費支持</string>
    <string name="supporter_purchase_error">目前無法連線 Google Play 結帳服務，請稍後再試。</string>
    <string name="phrase_collections_title">關聯詞詞庫（%1$d）</string>
    <string name="phrase_collections_title_unavailable">關聯詞詞庫</string>
    <string name="phrase_collections_description">選擇要啟用的關聯詞詞庫，變更會在下次顯示輸入鍵盤時生效。完全不選代表不使用任何關聯詞詞庫。</string>
    <string name="phrase_select_all">全部啟用</string>
    <string name="phrase_base_only">僅小麥注音</string>
    <string name="phrase_select_none">全部關閉</string>
    <string name="phrase_status_count">已啟用 %1$d／%2$d 個詞庫</string>
    <string name="phrase_status_none">未啟用詞庫（%1$d／%2$d）</string>
    <string name="phrase_collections_unavailable">找不到詞庫資料</string>
    <string name="phrase_collection_item">%1$s　%2$s</string>
    <string name="privacy_note">字典、組字與選字均在裝置上執行；付費支持由 Google Play 結帳服務處理。輸入內容不會傳送給開發者。</string>
