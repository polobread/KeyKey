    <string name="keyboard_spacing_small">小</string>
    <string name="keyboard_spacing_medium">中</string>
    <string name="keyboard_spacing_large">大</string>
    <string name="keyboard_font_size">字體大小</string>
    <string name="keyboard_font_normal">標準</string>
    <string name="keyboard_font_medium">中</string>
    <string name="keyboard_font_large">大</string>
    <string name="keyboard_font_extra_large">特大</string>
    <string name="keyboard_delete_position">刪除鍵位置</string>
    <string name="keyboard_delete_left">下方</string>
    <string name="keyboard_delete_above">右側</string>
    <string name="virtual_keyboard_settings">虛擬鍵盤設定</string>
    <string name="physical_keyboard_settings">實體鍵盤設定</string>
    <string name="keyboard_profiles_shared_data">虛擬與實體鍵盤各自保存輸入設定，詞庫、自訂詞與學習紀錄共用。</string>
    <string name="hardware_advanced_description">適用一般候選列與浮動候選窗。開啟雙排選字時此項不生效，仍保留原選擇；說明可照常開啟。變更會在目前組字完成後套用。</string>
    <string name="hardware_candidate_before_cursor">選游標前方的字</string>
    <string name="hardware_selection_returns_to_end">選字及後續輸入回到句尾</string>
    <string name="hardware_escape_clears_composition">按 Esc 清除整段組字</string>
    <string name="hardware_ignore_caps">中文模式忽略 Caps Lock</string>
    <string name="hardware_shift_upper">按 Shift 輸入大寫英文</string>
    <string name="hardware_max_syllables">好打注音組字長度</string>
    <string name="hardware_composition_mode_description">好打注音可連續組句，不必逐字選字。一般候選列與浮動窗可按 ←／→ 移動組字游標、↓ 開啟候選，再用 ↑／↓ 或 1–9 選字；雙排模式可點組字格換字。空白鍵行為依下方設定，傳統注音逐字選字。</string>
    <string name="hardware_space_selects_candidates_description">僅適用好打注音，預設關閉。讀音完成後按空白會插入空白，未完成讀音時仍以空白結束一聲；開啟後可用空白鍵完成讀音、開啟候選及翻頁。關閉時仍可按 ↓ 開啟候選。</string>
    <string name="simplified_chinese_output_description">開啟後，送入 App 的中文字轉為簡體；組字與候選維持繁體。與另一種鍵盤分開保存。</string>
    <string name="candidate_color_description">設定目前選取候選字的底色，與另一種鍵盤分開保存。</string>
    <string name="hardware_haptic_feedback_title">面板觸控震動回饋</string>
    <string name="hardware_haptic_feedback_description">點選候選列、浮動候選窗或面板時震動，不會讓外接鍵盤按鍵震動。可選 0–100 毫秒，0 為關閉；放開滑桿會試震一次。與另一種鍵盤分開保存。</string>
    <string name="keyboard_font_size_description">標準保留鍵帽上的英文字母提示；中、大、特大隱藏提示，讓主要字樣放大。只調整螢幕鍵帽與組字列的顯示。</string>
    <string name="hardware_omit_tone_description">預設關閉，適用好打注音的五種注音配置，以及一般候選列、雙排選字與浮動候選窗。開啟後可連續輸入讀音，自動分音節，也能照常輸入聲調。雙排維持 9 格組字區。</string>
    <string name="hardware_candidate_before_cursor_description">開啟時，按 ↓ 開啟游標前方字詞的候選；關閉時，選取游標所在位置的字詞。</string>
    <string name="hardware_selection_returns_to_end_description">開啟時，選字後回到句尾，後續讀音也從句尾接續；關閉時依目前游標位置繼續組字。</string>
    <string name="hardware_escape_clears_composition_description">開啟時，沒有未完成讀音再按 Esc 會清除整段組字；關閉時保留組字。仍有未完成讀音時，Esc 先清除讀音。</string>
    <string name="hardware_ignore_caps_description">開啟時，中文模式不受 Caps Lock 影響；英文模式仍保留 Caps Lock 的大小寫功能。預設關閉。</string>
    <string name="hardware_shift_upper_description">開啟時，按住 Shift 輸入英文字母會強制使用大寫；關閉時沿用鍵盤事件的大小寫。預設關閉。</string>
    <string name="hardware_max_syllables_description">可保留 10–20 個已完成音節。超過上限時，最前面的完整詞段會送入 App；已送出的字不再留在組字區供換字。</string>
</resources>
