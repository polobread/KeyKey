<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="bopomofo_keyboard_layout">注音鍵盤</string>
    <string name="bopomofo_keyboard_layout_description">好打與傳統注音、實體與虛擬鍵盤共用配置。預設標準；選許氏鍵盤時，虛擬鍵盤維持英文鍵帽。</string>
    <string-array name="bopomofo_keyboard_layouts">
        <item>標準</item>
        <item>許氏鍵盤</item>
    </string-array>
    <string name="app_name">琦琦輸入法</string>
    <string name="ime_name">@string/app_name</string>
    <string name="ime_subtype_name">繁體中文（標準注音）</string>
    <string name="setup_title">@string/app_name</string>
    <string name="version_info">版本 %1$s</string>
    <string name="setup_description">使用與電腦相同的標準注音鍵位，支援可選關聯詞詞庫、直式、橫式以及 USB／藍牙實體鍵盤。</string>
    <string name="enable_ime">1. 啟用輸入法</string>
    <string name="choose_ime">2. 選擇琦琦輸入法</string>
    <string name="open_settings">3. 調整設定</string>
    <string name="settings_title">琦琦輸入法設定</string>
    <string name="settings_group_composition">注音與選字</string>
    <string name="settings_group_composition_summary">注音鍵盤：%1$s · 上下文：%2$s</string>
    <string name="settings_value_on">開啟</string>
    <string name="settings_value_off">關閉</string>
    <string name="settings_group_table">倉頡與簡易</string>
    <string name="settings_group_table_summary">即時候選、錯碼清除、倉頡標點與選字排序</string>
    <string name="settings_group_table_description">倉頡最多五碼，簡易滿兩碼查詢；兩者使用逐字選字與關聯詞。下方可分別調整兩種輸入法的選項。點鍵盤的「設」即可選擇輸入法。</string>
    <string name="settings_group_appearance">外觀與操作</string>
    <string name="settings_group_appearance_summary">鍵盤高度、底部空間、震動、按鍵預覽、候選顏色</string>
    <string name="settings_group_hardware">實體鍵盤</string>
    <string name="settings_group_hardware_summary">浮動候選窗、數字符號鍵、底部空間</string>
    <string name="settings_group_phrases">關聯詞詞庫</string>
    <string name="settings_group_phrases_summary">選擇要啟用的詞庫</string>
    <string name="settings_group_expand">展開%1$s</string>
    <string name="settings_group_collapse">收合%1$s</string>

    <string name="composition_mode_title">輸入法</string>
    <string-array name="composition_modes">
        <item>好打注音</item>
        <item>傳統注音</item>
        <item>倉頡</item>
        <item>簡易</item>
    </string-array>
    <string name="composition_mode_description">好打注音會連續組句，不必逐字選字。螢幕鍵盤會即時把已組好的中文字寫入 App；點上方組字列中的字可改選候選，搜尋／前往／Enter 按一次即可執行。使用實體鍵盤時，按 ←／→ 移動組字游標，Space／↓ 開啟游標處的字詞候選，↑／↓ 或 1–9 選字詞。傳統注音使用逐字選字。</string>
    <string name="smart_bigram_enabled">好打注音使用上下文選字（Bigram）</string>
    <string name="smart_bigram_description">預設開啟。關閉可減少組句查詢負擔，改依字詞頻率選字，自動選字可能較不準；仍可整句輸入、選字及使用自訂詞。關閉期間暫停相鄰詞學習，保留既有學習紀錄。只影響好打注音。</string>
    <string name="haptic_feedback_title">按鍵震動回饋</string>
    <string name="haptic_feedback_description">可選 0、1、2、3、5、10、20、30、50、100 毫秒。放開滑桿後會以所選時間試震一次；設定為 0 時關閉震動。</string>
    <string name="haptic_off">0 秒（關閉）</string>
    <string name="haptic_maximum">0.1 秒</string>
    <string name="haptic_value_off">震動時間：關閉</string>
    <string name="haptic_value_seconds">震動時間：%1$s 秒（%2$d ms）</string>
    <string name="keyboard_size_title">虛擬鍵盤高度</string>
    <string name="keyboard_size_description" formatted="false">直式與橫式可分別選擇 50%、75%、90%、100%、110%、125%、150%、175%、200%；只影響螢幕虛擬鍵盤，實體鍵盤候選字窗維持原尺寸。</string>
    <string name="keyboard_size_portrait">直式虛擬鍵盤</string>
    <string name="keyboard_size_landscape">橫式虛擬鍵盤</string>
    <string name="keyboard_size_value">目前高度：%1$d%%</string>
    <string name="keyboard_size_minimum">50%</string>
    <string name="keyboard_size_maximum">200%</string>
    <string name="key_preview_enabled">顯示觸控按鍵預覽</string>
    <string name="key_preview_description">按住文字、注音或符號鍵時，在按鍵上方或附近顯示放大的按鍵圖，方便確認是否按對。</string>
    <string name="candidate_color_title">候選字底色</string>
    <string-array name="candidate_highlight_colors">
        <item>紫色（預設）</item>
        <item>綠色</item>
        <item>黃色</item>
        <item>紅色</item>
    </string-array>
    <string name="floating_candidates_enabled">使用浮動候選字窗</string>
    <string name="floating_candidates_failure_token">已改用一般候選列：系統或目標 App 未提供可用的輸入法視窗 token。重新勾選可再試一次。</string>
    <string name="floating_candidates_failure_cursor_anchor">已關閉浮動候選字窗並改用一般候選列：目前 App 持續未提供有效的游標位置。重新勾選可再試一次。</string>
    <string name="floating_candidates_failure_attach">已改用一般候選列：系統拒絕附掛浮動候選字窗。重新勾選可再試一次。</string>
    <string name="floating_candidates_layout">浮動候選字窗排列</string>
    <string name="hardware_number_row_enabled">顯示虛擬數字與符號鍵</string>
    <string name="bottom_language_space_enabled">預留底部切換語言空間</string>
    <string name="touch_bottom_space_description">開啟時為系統的切換語言按鈕預留空間；關閉時虛擬鍵盤貼齊底部。</string>
    <string name="hardware_bottom_space_description">開啟時為系統的切換語言按鈕預留空間；關閉時候選列貼齊底部。使用浮動候選字窗時無法調整。</string>
    <string-array name="floating_candidate_layouts">
        <item>垂直選字窗</item>
        <item>水平選字窗</item>
    </string-array>
