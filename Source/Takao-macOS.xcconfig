OPENSSL_PREFIX = /opt/homebrew/opt/openssl@3

// Ordinary macOS targets include Guanyinma and select Rust when no core
// preference exists. Explicit KEYKEY_ENABLE_GUANYINMA=0 is a legacy-only
// developer build; existing user choices are preserved in dual-core builds.
KEYKEY_GUANYINMA_LDFLAGS_0 =
KEYKEY_GUANYINMA_LDFLAGS_1 = "$(DERIVED_FILE_DIR)/Guanyinma/libguanyinma.a" -liconv
// Pass KEYKEY_GUANYINMA_OFFLINE=1 when the pinned toolchain and dependencies are cached.

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 15.0
ARCHS = arm64
ONLY_ACTIVE_ARCH = NO
GCC_VERSION = com.apple.compilers.llvm.clang.1_0
CLANG_CXX_LANGUAGE_STANDARD = gnu++17
CLANG_CXX_LIBRARY = libc++
HEADER_SEARCH_PATHS = $(inherited) $(OPENSSL_PREFIX)/include
OTHER_LDFLAGS = $(inherited) -lsqlite3 $(OPENSSL_PREFIX)/lib/libcrypto.a
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/../update/.cache/macos-2.10.0

// Distribution builds must not acquire the debugger entitlement. Keep Debug
// unchanged so developers can still attach a debugger locally.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO
